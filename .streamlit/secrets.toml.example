# Streamlit Secrets Configuration Template
# Copy this to secrets.toml and fill in your values
# DO NOT commit secrets.toml to git

# API Configuration
# Local: http://localhost:8000
# Render: https://postpilot-api.onrender.com
API_BASE_URL = "http://localhost:8000"

# Facebook Credentials (only needed for local dev; use env vars on Render)
FACEBOOK_PAGE_ID = "your_facebook_page_id"
FACEBOOK_ACCESS_TOKEN = "your_page_access_token"

# System Configuration
MAX_POSTS_PER_DAY = 15
SCRAPE_INTERVAL = 30
POST_INTERVAL = 60
