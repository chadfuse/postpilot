# Facebook Configuration
# Get Page Access Token from https://developers.facebook.com/tools/explorer/
# Required permissions: pages_manage_posts, pages_read_engagement, publish_video
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_ACCESS_TOKEN=your_page_access_token

# Redis Configuration
# Local: redis://localhost:6379
# Render: auto-injected via render.yaml
REDIS_URL=redis://localhost:6379

# File Paths
# Local development
DOWNLOAD_PATH=videos
DATABASE_PATH=app/database.db
LOG_PATH=logs
# Render (persistent disk at /var/data):
# DOWNLOAD_PATH=/var/data/videos
# DATABASE_PATH=/var/data/app.db
# LOG_PATH=/var/data/logs

# System Configuration
MAX_POSTS_PER_DAY=15
SCRAPE_INTERVAL=30
POST_INTERVAL=60

# Limits
MAX_VIDEOS_PER_KEYWORD=50
MAX_DOWNLOAD_RETRIES=3
MAX_POST_RETRIES=3
